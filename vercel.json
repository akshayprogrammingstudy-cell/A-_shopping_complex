{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "shopping-platform": {
      "root": "a3-shopping-platform",
      "framework": "vite"
    },
    "api-server": {
      "root": "api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "shopping-platform"
      }
    }
  ]
}
